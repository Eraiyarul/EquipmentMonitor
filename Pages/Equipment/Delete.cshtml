@page "{id:int}"
@model EquipmentMonitor.Pages.Equipment.DeleteModel
@{
    ViewData["Title"] = "Delete Station";
    ViewData["Page"]  = "delete";
}

<div class="detail-header">
    <div>
        <a asp-page="/Index" class="detail-back"><i class="bi bi-chevron-left"></i> Dashboard</a>
        <div class="detail-title">Delete Station</div>
    </div>
</div>

<div style="max-width:500px;margin:40px auto;">
    <div class="card" style="border:1px solid rgba(239,68,68,.4);border-radius:14px;padding:32px;background:var(--bg-card);">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:24px;">
            <div style="width:44px;height:44px;border-radius:10px;background:rgba(239,68,68,.15);display:flex;align-items:center;justify-content:center;font-size:20px;color:var(--red);">
                <i class="bi bi-trash3-fill"></i>
            </div>
            <div>
                <div style="font-size:16px;font-weight:700;color:var(--text-primary)">@Model.Equipment.Name</div>
                <div style="font-size:12px;color:var(--text-muted)">@Model.Equipment.Type &nbsp;·&nbsp; @Model.Equipment.Location</div>
            </div>
        </div>

        <p style="font-size:13px;color:var(--text-muted);margin-bottom:24px;line-height:1.6;">
            This will permanently delete this equipment station along with all its readings, alerts, and threshold configurations.
            <strong style="color:var(--red)">This action cannot be undone.</strong>
        </p>

        <form method="post">
            <input type="hidden" asp-for="Equipment.Id" />
            <div style="display:flex;gap:12px;">
                <a asp-page="/Index" class="btn" style="flex:1;padding:11px;background:var(--bg-surface);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text-muted);font-size:13px;font-weight:600;text-align:center;text-decoration:none;">
                    Cancel
                </a>
                <button type="submit" style="flex:1;padding:11px;background:var(--red);border:none;border-radius:var(--radius-sm);color:#fff;font-size:13px;font-weight:700;cursor:pointer;letter-spacing:.4px;">
                    <i class="bi bi-trash3"></i> DELETE STATION
                </button>
            </div>
        </form>
    </div>
</div>
