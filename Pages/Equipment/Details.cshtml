@page "{id:int}"
@model EquipmentMonitor.Pages.Equipment.DetailsModel
@{
    ViewData["Title"] = Model.Equipment.Name;
    ViewData["Page"]  = "detail";

    var (ledClass, pillClass, pillIcon) = Model.Equipment.Status switch
    {
        EquipmentMonitor.Models.EquipmentStatus.Active           => ("led-green",  "active",      "bi-check-circle-fill"),
        EquipmentMonitor.Models.EquipmentStatus.Idle             => ("led-blue",   "idle",        "bi-pause-circle-fill"),
        EquipmentMonitor.Models.EquipmentStatus.Faulty           => ("led-red",    "faulty",      "bi-x-circle-fill"),
        EquipmentMonitor.Models.EquipmentStatus.UnderMaintenance => ("led-yellow", "maintenance", "bi-tools"),
        _ => ("led-gray", "idle", "bi-question")
    };

    var temp     = Model.RecentReadings.FirstOrDefault(r => r.MetricType == "Temperature");
    var humidity = Model.RecentReadings.FirstOrDefault(r => r.MetricType == "Humidity");
    var pressure = Model.RecentReadings.FirstOrDefault(r => r.MetricType == "Pressure");

    double Pct(double val, double min, double max) => Math.Clamp((val - min) / (max - min) * 100, 0, 100);
    var tThresh = Model.Thresholds.FirstOrDefault(t => t.MetricType == "Temperature");
    var hThresh = Model.Thresholds.FirstOrDefault(t => t.MetricType == "Humidity");
    var pThresh = Model.Thresholds.FirstOrDefault(t => t.MetricType == "Pressure");
}

<!-- Detail Header -->
<div class="detail-header">
    <div>
        <a asp-page="/Index" class="detail-back"><i class="bi bi-chevron-left"></i> Dashboard</a>
        <div class="detail-title">
            <span class="led @ledClass"></span>
            @Model.Equipment.Name
            <span class="status-pill @pillClass" style="font-size:12px">
                <i class="bi @pillIcon"></i> @Model.Equipment.Status
            </span>
        </div>
        <div class="detail-meta">
            <span class="detail-meta-item"><i class="bi bi-geo-alt"></i>@Model.Equipment.Location</span>
            <span class="detail-meta-item"><i class="bi bi-tag"></i>@Model.Equipment.Type</span>
            <span class="detail-meta-item"><i class="bi bi-calendar3"></i>Installed @Model.Equipment.InstalledDate.ToString("dd MMM yyyy")</span>
            <span class="detail-meta-item"><i class="bi bi-database"></i>@Model.RecentReadings.Count readings loaded</span>
        </div>
    </div>
    <div style="display:flex;gap:10px;align-items:center;">
        <a asp-page="/Equipment/Edit" asp-route-id="@Model.Equipment.Id" class="btn-iot btn-iot-ghost">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-page="/Equipment/Delete" asp-route-id="@Model.Equipment.Id"
           style="padding:8px 14px;background:transparent;border:1px solid rgba(239,68,68,.4);border-radius:var(--radius-sm);color:var(--red);font-size:12.5px;font-weight:600;text-decoration:none;display:flex;align-items:center;gap:6px;transition:border-color var(--transition);"
           onmouseover="this.style.borderColor='var(--red)'" onmouseout="this.style.borderColor='rgba(239,68,68,.4)'">
            <i class="bi bi-trash3"></i> Delete
        </a>
    </div>
</div>

<!-- ── Metric Gauges ─────────────────────────────────────────────── -->
<div class="metric-gauge-grid">
    @{
        void RenderGauge(string label, string icon, string iconColor,
                         EquipmentMonitor.Models.Reading? reading,
                         EquipmentMonitor.Models.Threshold? thresh)
        {
            bool hasData = reading != null;
            bool alert   = hasData && thresh != null &&
                           (reading!.Value < thresh.MinValue || reading.Value > thresh.MaxValue);
            double pct   = (hasData && thresh != null)
                           ? Pct(reading!.Value, thresh.MinValue, thresh.MaxValue)
                           : 0;
            string rangeText = thresh != null
                ? $"Safe: {thresh.MinValue} – {thresh.MaxValue}"
                : "No threshold set";
        <div class="gauge-card @(alert ? "alert" : "")">
            <div class="gauge-label">
                <span style="color:@iconColor"><i class="bi @icon" style="margin-right:5px"></i>@label</span>
                @if (alert) {
                    <span style="color:var(--red);font-size:11px"><i class="bi bi-exclamation-triangle-fill"></i> BREACH</span>
                }
            </div>
            <div class="gauge-main" id="gauge-@label.ToLower()">
                @if (hasData) {
                    <span>@reading!.Value</span><span class="gauge-unit">@reading.Unit</span>
                } else {
                    <span style="font-size:22px;color:var(--text-muted)">No data</span>
                }
            </div>
            <div class="gauge-range">@rangeText</div>
            @if (hasData && thresh != null) {
                <div class="gauge-bar">
                    <div class="gauge-fill @(alert ? "alert" : "")" style="width:@(pct.ToString("F0"))%"></div>
                </div>
            }
        </div>
        }
    }
    @{ RenderGauge("Temperature", "bi-thermometer-half", "#f59e0b", temp, tThresh); }
    @{ RenderGauge("Humidity",    "bi-droplet-half",     "#06b6d4", humidity, hThresh); }
    @{ RenderGauge("Pressure",    "bi-speedometer",      "#8b5cf6", pressure, pThresh); }
</div>

<!-- ── Bottom: Chart + Alerts ────────────────────────────────────── -->
<div class="two-col" style="margin-bottom:24px">
    <!-- Historical Chart -->
    <div class="panel">
        <div class="panel-header" style="flex-wrap:wrap;gap:10px;">
            <div class="panel-title"><i class="bi bi-graph-up"></i> Sensor History</div>
            <!-- Date-range filter -->
            <form method="get" style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;">
                <input type="hidden" name="id" value="@Model.Equipment.Id" />
                <label style="font-size:11px;color:var(--text-muted);margin:0">From</label>
                <input type="date" name="From" value="@Model.From?.ToString("yyyy-MM-dd")"
                       style="background:var(--bg-base);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text-primary);font-size:12px;padding:4px 8px;" />
                <label style="font-size:11px;color:var(--text-muted);margin:0">To</label>
                <input type="date" name="To" value="@Model.To?.ToString("yyyy-MM-dd")"
                       style="background:var(--bg-base);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text-primary);font-size:12px;padding:4px 8px;" />
                <button type="submit" style="padding:4px 12px;background:var(--blue);border:none;border-radius:var(--radius-sm);color:#fff;font-size:12px;font-weight:600;cursor:pointer;">
                    Filter
                </button>
                <a asp-page="/Equipment/Details" asp-route-id="@Model.Equipment.Id"
                   style="font-size:11px;color:var(--text-muted);text-decoration:none;">Reset</a>
            </form>
        </div>
        <div class="chart-wrap" style="height:220px">
            <canvas id="historyChart"></canvas>
        </div>
    </div>

    <!-- Thresholds -->
    <div class="panel">
        <div class="panel-header">
            <div class="panel-title"><i class="bi bi-sliders"></i> Configured Thresholds</div>
        </div>
        <table class="iot-table">
            <thead>
                <tr><th>Metric</th><th>Min</th><th>Max</th></tr>
            </thead>
            <tbody>
                @if (!Model.Thresholds.Any())
                {
                    <tr><td colspan="3" class="empty-state">No thresholds</td></tr>
                }
                @foreach (var t in Model.Thresholds)
                {
                    <tr>
                        <td>@t.MetricType</td>
                        <td class="mono" style="color:var(--cyan)">@t.MinValue</td>
                        <td class="mono" style="color:var(--yellow)">@t.MaxValue</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ── Recent Readings ───────────────────────────────────────────── -->
<div class="panel" style="margin-bottom:24px">
    <div class="panel-header">
        <div class="panel-title"><i class="bi bi-table"></i> Recent Readings</div>
        <span style="font-size:11px;color:var(--text-muted)">Live updates via SignalR</span>
    </div>
    <div style="max-height:260px;overflow-y:auto">
        <table class="iot-table">
            <thead>
                <tr><th>#</th><th>Metric</th><th>Value</th><th>Unit</th><th>Timestamp (UTC)</th></tr>
            </thead>
            <tbody id="readings-body">
                @if (!Model.RecentReadings.Any())
                {
                    <tr><td colspan="5" class="empty-state">No readings yet</td></tr>
                }
                @{ int rn = 1; }
                @foreach (var r in Model.RecentReadings)
                {
                    <tr>
                        <td class="td-muted">@(rn++)</td>
                        <td>@r.MetricType</td>
                        <td class="mono" style="color:var(--text-primary);font-weight:700">@r.Value</td>
                        <td class="td-muted">@r.Unit</td>
                        <td class="td-muted mono">@r.Timestamp.ToString("dd MMM HH:mm:ss")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- ── Alert History ─────────────────────────────────────────────── -->
<div class="panel">
    <div class="panel-header">
        <div class="panel-title"><i class="bi bi-bell-fill" style="color:var(--red)"></i> Alert History</div>
    </div>
    <table class="iot-table">
        <thead>
            <tr><th>Status</th><th>Message</th><th>Created (UTC)</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @if (!Model.RecentAlerts.Any())
            {
                <tr><td colspan="4" class="empty-state"><i class="bi bi-shield-check" style="color:var(--green)"></i> No alerts for this station</td></tr>
            }
            @foreach (var a in Model.RecentAlerts)
            {
                var badgeClass = a.Status switch
                {
                    EquipmentMonitor.Models.AlertStatus.Active       => "badge-active",
                    EquipmentMonitor.Models.AlertStatus.Acknowledged => "badge-ack",
                    EquipmentMonitor.Models.AlertStatus.Resolved     => "badge-resolved",
                    _ => "badge-ack"
                };
                <tr>
                    <td><span class="@badgeClass">@a.Status</span></td>
                    <td style="font-size:12.5px">@a.Message</td>
                    <td class="td-muted mono" style="font-size:12px">@a.CreatedAt.ToString("dd MMM HH:mm")</td>
                    <td>
                        <div style="display:flex;gap:6px;flex-wrap:wrap">
                            @if (a.Status == EquipmentMonitor.Models.AlertStatus.Active)
                            {
                                <form method="post" asp-page-handler="Acknowledge">
                                    <input type="hidden" name="alertId" value="@a.Id" />
                                    <input type="hidden" name="equipmentId" value="@Model.Equipment.Id" />
                                    <button class="btn-iot btn-iot-warn btn-iot-sm" type="submit">
                                        <i class="bi bi-check"></i> Ack
                                    </button>
                                </form>
                            }
                            @if (a.Status != EquipmentMonitor.Models.AlertStatus.Resolved)
                            {
                                <form method="post" asp-page-handler="Resolve">
                                    <input type="hidden" name="alertId" value="@a.Id" />
                                    <input type="hidden" name="equipmentId" value="@Model.Equipment.Id" />
                                    <button class="btn-iot btn-iot-success btn-iot-sm" type="submit">
                                        <i class="bi bi-check-all"></i> Resolve
                                    </button>
                                </form>
                            }
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@section Scripts {
<script>
const equipId = @Model.Equipment.Id;

// ── Historical Chart ────────────────────────────────────────────────
Chart.defaults.color        = '#475569';
Chart.defaults.borderColor  = '#1e3050';

const labels   = [@Html.Raw(string.Join(",", Model.RecentReadings.OrderBy(r => r.Timestamp).Select(r => $"'{r.Timestamp:HH:mm:ss}'")))];
const tempData = [@Html.Raw(string.Join(",", Model.RecentReadings.OrderBy(r => r.Timestamp).Where(r => r.MetricType == "Temperature").Select(r => r.Value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))))];
const humData  = [@Html.Raw(string.Join(",", Model.RecentReadings.OrderBy(r => r.Timestamp).Where(r => r.MetricType == "Humidity").Select(r => r.Value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))))];
const presData = [@Html.Raw(string.Join(",", Model.RecentReadings.OrderBy(r => r.Timestamp).Where(r => r.MetricType == "Pressure").Select(r => r.Value.ToString("F1", System.Globalization.CultureInfo.InvariantCulture))))];

// Align datasets to same label count using sparse points
const historyChart = new Chart(
    document.getElementById('historyChart').getContext('2d'), {
    type: 'line',
    data: {
        labels: labels.slice(-20),
        datasets: [
            { label: 'Temperature (°C)', data: tempData.slice(-20), borderColor:'#f59e0b', backgroundColor:'rgba(245,158,11,.1)', tension:.4, pointRadius:3 },
            { label: 'Humidity (%)',      data: humData.slice(-20),  borderColor:'#06b6d4', backgroundColor:'rgba(6,182,212,.1)',  tension:.4, pointRadius:3 },
            { label: 'Pressure (hPa)',    data: presData.slice(-20), borderColor:'#8b5cf6', backgroundColor:'rgba(139,92,246,.1)', tension:.4, pointRadius:3, hidden: true }
        ]
    },
    options: {
        responsive: true, maintainAspectRatio: false,
        animation: { duration: 300 },
        plugins: { legend: { position:'top', labels:{ font:{size:11}, boxWidth:12, color:'#7b92b8', padding:10 } } },
        scales: {
            x: { ticks:{ maxTicksLimit:6, font:{size:10}, color:'#445a7a' }, grid:{color:'#1e3050'} },
            y: { ticks:{ font:{size:10}, color:'#445a7a' }, grid:{color:'#1e3050'} }
        }
    }
});

// ── Live Updates ────────────────────────────────────────────────────
const gaugeMap = { 'Temperature':'gauge-temperature', 'Humidity':'gauge-humidity', 'Pressure':'gauge-pressure' };
let rowCounter = @(Model.RecentReadings.Count + 1);

connection.on('NewReading', r => {
    if (r.equipmentId !== equipId) return;

    // Update gauge
    const gaugeEl = document.getElementById(gaugeMap[r.metricType]);
    if (gaugeEl) gaugeEl.innerHTML = `<span>${r.value}</span><span class="gauge-unit">${r.unit}</span>`;

    // Prepend reading to table
    const tbody = document.getElementById('readings-body');
    const ph = tbody.querySelector('td[colspan]');
    if (ph) ph.closest('tr').remove();

    const tr = document.createElement('tr');
    tr.innerHTML = `<td style="color:var(--text-muted)">${rowCounter++}</td>
                    <td>${r.metricType}</td>
                    <td class="mono" style="color:var(--text-primary);font-weight:700">${r.value}</td>
                    <td style="color:var(--text-muted)">${r.unit}</td>
                    <td style="color:var(--text-muted);font-family:monospace;font-size:12px">${r.timestamp}</td>`;
    tbody.insertBefore(tr, tbody.firstChild);
    while (tbody.children.length > 20) tbody.removeChild(tbody.lastChild);

    // Update chart
    const ds = historyChart.data.datasets;
    const lbl = r.timestamp;
    if (r.metricType === 'Temperature') { ds[0].data.push(r.value); historyChart.data.labels.push(lbl); }
    if (r.metricType === 'Humidity')    ds[1].data.push(r.value);
    if (r.metricType === 'Pressure')    ds[2].data.push(r.value);
    if (historyChart.data.labels.length > 20) {
        historyChart.data.labels.shift();
        ds.forEach(d => { if (d.data.length > 20) d.data.shift(); });
    }
    historyChart.update('none');
});
</script>
}
